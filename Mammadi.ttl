###  http://www.semanticweb.org/muhammadabdulrehma/ontologies/2026/9/untitled-ontology-3#Application
untitled-ontology-3:Application rdf:type owl:Class ;
                                rdfs:subClassOf untitled-ontology-3:ITResource .


###  http://www.semanticweb.org/muhammadabdulrehma/ontologies/2026/9/untitled-ontology-3#Database
untitled-ontology-3:Database rdf:type owl:Class ;
                             rdfs:subClassOf untitled-ontology-3:ITResource .


###  http://www.semanticweb.org/muhammadabdulrehma/ontologies/2026/9/untitled-ontology-3#Developer
untitled-ontology-3:Developer rdf:type owl:Class ;
                              rdfs:subClassOf untitled-ontology-3:Employee .


###  http://www.semanticweb.org/muhammadabdulrehma/ontologies/2026/9/untitled-ontology-3#Employee
untitled-ontology-3:Employee rdf:type owl:Class ;
                             rdfs:subClassOf untitled-ontology-3:Person .


###  http://www.semanticweb.org/muhammadabdulrehma/ontologies/2026/9/untitled-ontology-3#ITResource
untitled-ontology-3:ITResource rdf:type owl:Class .


###  http://www.semanticweb.org/muhammadabdulrehma/ontologies/2026/9/untitled-ontology-3#Incident
untitled-ontology-3:Incident rdf:type owl:Class .


###  http://www.semanticweb.org/muhammadabdulrehma/ontologies/2026/9/untitled-ontology-3#Manager
untitled-ontology-3:Manager rdf:type owl:Class ;
                            rdfs:subClassOf untitled-ontology-3:Employee .


###  http://www.semanticweb.org/muhammadabdulrehma/ontologies/2026/9/untitled-ontology-3#Person
untitled-ontology-3:Person rdf:type owl:Class .


###  http://www.semanticweb.org/muhammadabdulrehma/ontologies/2026/9/untitled-ontology-3#Project
untitled-ontology-3:Project rdf:type owl:Class .


###  http://www.semanticweb.org/muhammadabdulrehma/ontologies/2026/9/untitled-ontology-3#ProjectDeveloper
untitled-ontology-3:ProjectDeveloper rdf:type owl:Class ;
                                     owl:equivalentClass [ owl:intersectionOf ( untitled-ontology-3:Employee
                                                                                [ rdf:type owl:Restriction ;
                                                                                  owl:onProperty untitled-ontology-3:worksOn ;
                                                                                  owl:someValuesFrom untitled-ontology-3:Project
                                                                                ]
                                                                              ) ;
                                                           rdf:type owl:Class
                                                         ] ;
                                     rdfs:subClassOf untitled-ontology-3:Employee .


###  http://www.semanticweb.org/muhammadabdulrehma/ontologies/2026/9/untitled-ontology-3#Server
untitled-ontology-3:Server rdf:type owl:Class ;
                           rdfs:subClassOf untitled-ontology-3:ITResource .


###  http://www.semanticweb.org/muhammadabdulrehma/ontologies/2026/9/untitled-ontology-3#SystemAdministrator
untitled-ontology-3:SystemAdministrator rdf:type owl:Class ;
                                        rdfs:subClassOf untitled-ontology-3:Employee .


###  http://www.semanticweb.org/muhammadabdulrehma/ontologies/2026/9/untitled-ontology-3#Technology
untitled-ontology-3:Technology rdf:type owl:Class .


